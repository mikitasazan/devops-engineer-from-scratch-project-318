MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-local-password
STORAGE_S3_BUCKET=bulletin-files
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ENDPOINT=http://minio:9000
STORAGE_S3_ACCESSKEY=minioadmin
STORAGE_S3_SECRETKEY=change-this-local-password
# Browser-reachable base URL for image links; STORAGE_S3_ENDPOINT above is the
# container-internal address the app uses to talk to MinIO and is not
# reachable from the browser.
STORAGE_S3_CDNURL=http://localhost:9000/bulletin-files
